# --------------------------------------------------------------------------
# Configuración del deploy. Copiá este archivo a .env y completá los valores.
#
#   cp .env.example .env
#
# .env está en .gitignore — nunca lo commitees.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Dominio
# --------------------------------------------------------------------------

# Dominio (o subdominio) que apunta por DNS a la IP de este servidor.
# Tiene que resolver ANTES de levantar todo, o Let's Encrypt no puede
# validar y no emite el certificado.
DOMAIN=n8n.tudominio.com

# Dirección donde Let's Encrypt avisa si un certificado está por vencer.
ACME_EMAIL=vos@tudominio.com

# Zona horaria del servidor. Importa para los nodos con horarios (Cron) y
# para las validaciones de horario comercial de la demo 01.
TIMEZONE=America/Argentina/Cordoba

# --------------------------------------------------------------------------
# Base de datos
# --------------------------------------------------------------------------

POSTGRES_USER=n8n
POSTGRES_DB=n8n

# Generá una contraseña larga al azar:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --------------------------------------------------------------------------
# n8n
# --------------------------------------------------------------------------

# Clave con la que n8n cifra las credenciales guardadas. Generala una sola vez:
#   openssl rand -hex 32
#
# ⚠️  Si esta clave cambia, n8n no puede desencriptar las credenciales que ya
# tenía guardadas y hay que volver a cargarlas todas a mano. Guardala junto
# con los backups de la base.
N8N_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# Demo 01 — WhatsApp Agent
#
# Los secretos (access token de Meta, API key del LLM) NO van acá: se cargan
# como credenciales dentro de n8n. Ver demos/01-whatsapp-agent/README.md.
# --------------------------------------------------------------------------

# Phone Number ID del número que envía (Meta → WhatsApp → API Setup).
# Es un ID numérico opaco, no el número de teléfono.
WHATSAPP_PHONE_NUMBER_ID=

# Número del dueño de la inmobiliaria, donde llegan las derivaciones.
# Cualquier formato sirve: el workflow lo normaliza.
OWNER_WHATSAPP_NUMBER=

AGENCY_NAME=Inmobiliaria Demo

# gemini (default) | anthropic | groq
LLM_PROVIDER=gemini

# Opcionales: vacíos usan el default de cada proveedor.
LLM_MODEL=
LLM_API_URL=
LLM_THINKING_LEVEL=
