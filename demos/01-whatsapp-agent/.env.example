# --------------------------------------------------------------------------
# Demo 01 — WhatsApp Agent (real estate agency)
#
# Copy this file to .env and fill in the values.
#
# Secrets (Twilio credentials, Claude API key) are NOT read from here by the
# workflow: they are configured as n8n credentials — see the README. The
# variables below are the non-secret configuration that the workflow reads
# through $env at runtime.
#
# IMPORTANT: n8n blocks access to environment variables from inside nodes by
# default. Set this on your n8n instance or the expressions below resolve to
# empty:
#
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# --------------------------------------------------------------------------

# WhatsApp-enabled number that sends the messages.
# For the Twilio sandbox this is always +14155238886.
# E.164 format, no "whatsapp:" prefix — the Twilio node adds it.
TWILIO_WHATSAPP_FROM=+14155238886

# Where human-handoff alerts are sent. Must have joined the Twilio sandbox.
OWNER_WHATSAPP_NUMBER=+5493519876543

# Claude model used for intent classification.
LLM_MODEL=claude-sonnet-5

# Agency name used in the customer-facing messages.
AGENCY_NAME=Inmobiliaria Demo

# --------------------------------------------------------------------------
# Reference only — these go into n8n credentials, not into $env.
# Listed here so you know what to have at hand before importing the workflow.
# --------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
