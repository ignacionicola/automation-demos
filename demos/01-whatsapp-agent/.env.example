# --------------------------------------------------------------------------
# Demo 01 — WhatsApp Agent (real estate agency)
#
# Copy this file to .env and fill in the values.
#
# Secrets (WhatsApp Cloud API access token, LLM API key) are NOT read from
# here by the workflow: they are configured as n8n credentials — see the
# README. The variables below are the non-secret configuration that the
# workflow reads through $env at runtime.
#
# IMPORTANT: n8n blocks access to environment variables from inside nodes by
# default. Set this on your n8n instance or the expressions below resolve to
# empty:
#
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# --------------------------------------------------------------------------

# The "Phone Number ID" of the WhatsApp-enabled number that sends the
# messages — an opaque numeric ID, NOT the phone number itself. Get it from
# Meta for Developers → your app → WhatsApp → API Setup ("From" number).
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Where human-handoff alerts are sent. Must have messaged the test number
# first (Meta only allows replies to numbers that messaged you within the
# last 24h, or that are added as testers while the app is in dev mode).
OWNER_WHATSAPP_NUMBER=+5493519876543

# --------------------------------------------------------------------------
# LLM provider for intent classification. Gemini is the default because it
# has a free tier — no card required, just a Google AI Studio API key.
# See the "LLM Provider" section in README.md for the full comparison table
# and example request bodies for each provider.
# --------------------------------------------------------------------------

# gemini (default) | anthropic | groq
LLM_PROVIDER=gemini

# Optional. Leave empty to use the sensible default for LLM_PROVIDER:
#   gemini    -> gemini-flash-latest (Google's alias for the current flash model)
#   anthropic -> claude-sonnet-5
#   groq      -> llama-3.3-70b-versatile
LLM_MODEL=

# Optional. Overrides the provider's default endpoint entirely — use this to
# point at a self-hosted or proxied endpoint compatible with one of the three
# request formats above.
LLM_API_URL=

# Gemini only. How much the model may "think" before answering:
#   minimal (default) | low | medium | high
#   off  -> omits thinkingConfig entirely. Use this if you point LLM_MODEL at
#           an older Gemini 2.5 model, which uses thinkingBudget instead of
#           thinkingLevel and rejects this field.
# Reasoning tokens are billed against maxOutputTokens, so a high level can
# truncate the JSON response. "minimal" measures 0 reasoning tokens in practice.
LLM_THINKING_LEVEL=

# Agency name used in the customer-facing messages.
AGENCY_NAME=Inmobiliaria Demo

# --------------------------------------------------------------------------
# Google Sheets — the client's own catalogue, business data and FAQ.
#
# Leave empty and the workflow falls back to the JSON bundled inside it, so
# the demo runs with no spreadsheet at all. See sheets-template/ for the
# three tabs and README.md for how to connect one.
# --------------------------------------------------------------------------

# The spreadsheet's ID: the long string between /d/ and /edit in its URL.
#   https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SHEETS_DOCUMENT_ID=

# --------------------------------------------------------------------------
# Google Calendar — where property visits are booked.
# --------------------------------------------------------------------------

# Which calendar receives the visits, as a calendar ID.
#
# NOT the string "primary": the n8n node validates this field against an
# email-shaped pattern and rejects anything else before it ever calls Google.
# The main calendar's ID *is* the account's email address, so that is what
# goes here. For a separate viewings calendar, use its own ID (Google Calendar
# -> that calendar's Settings -> "Calendar ID", something like
# c_a1b2c3@group.calendar.google.com).
GOOGLE_CALENDAR_ID=your-account@gmail.com

# --------------------------------------------------------------------------
# Reference only — these go into n8n credentials, not into $env. See the
# README's "Meta WhatsApp Cloud API setup" section for where to find each one
# and exactly which n8n credential field it goes into.
# --------------------------------------------------------------------------
#
# WhatsApp OAuth API credential (used by the WhatsApp Trigger node) —
# Meta for Developers → your app → App Settings → Basic:
# META_APP_ID=1234567890123456
# META_APP_SECRET=your-app-secret
#
# WhatsApp API credential (used by the two "send message" nodes) —
# Meta for Developers → your app → WhatsApp → API Setup:
# WHATSAPP_ACCESS_TOKEN=your-temporary-or-permanent-access-token
# WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456
#
# Google Calendar OAuth2 credential (used by the two Calendar nodes) —
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID:
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
#
# Google Sheets service account credential (used by the three Sheets nodes) —
# Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add key
# (JSON). n8n asks for two fields from that file:
# GOOGLE_SA_EMAIL=bot@your-project.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
#
# Gemini    (Google AI Studio, free tier): header "x-goog-api-key"
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Anthropic: header "x-api-key"
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
#
# Groq: header "Authorization", value "Bearer <key>"
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
